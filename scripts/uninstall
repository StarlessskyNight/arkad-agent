#!/usr/bin/env bash
# Uninstall Arkad Agent completely: install dir, command shims, config,
# data, and the PATH lines the installer added to your shell profiles.
#   curl -fsSL https://raw.githubusercontent.com/StarlessskyNight/arkad-agent/main/scripts/uninstall | bash
set -euo pipefail

INSTALL_DIR="${ARKAD_INSTALL_DIR:-${HOME}/.local/share/arkad-agent}"

# 1. Remove the arkad / arkad-agent shims wherever the installer could have put them.
for dir in "${HOME}/.local/bin" "/opt/homebrew/bin" "/usr/local/bin" "${ARKAD_BIN_DIR:-}"; do
  [ -z "$dir" ] && continue
  for name in arkad arkad-agent; do
    link="${dir}/${name}"
    if [ -L "$link" ]; then
      rm -f "$link"
      echo "removed $link"
    fi
  done
done

# 2. Remove the install dir.
if [ -d "${INSTALL_DIR}" ]; then
  rm -rf "${INSTALL_DIR}"
  echo "removed ${INSTALL_DIR}"
else
  echo "no install found at ${INSTALL_DIR}"
fi

# 3. Remove config and per-user data.
for p in "${HOME}/.config/arkad-agent" "${HOME}/.arkad"; do
  if [ -d "${p}" ]; then
    rm -rf "${p}"
    echo "removed ${p}"
  fi
done

# 4. Strip the PATH lines the installer appended to shell profiles.
for profile in "${HOME}/.zshrc" "${HOME}/.zprofile" "${HOME}/.bashrc" "${HOME}/.bash_profile" "${HOME}/.profile"; do
  [ -f "${profile}" ] || continue
  if grep -q "# Arkad command" "${profile}"; then
    # Drop the marker comment, the blank line before it, and the export line after it.
    sed -i.bak -e '/^# Arkad command$/,+1d' "${profile}"
    sed -i -e '/^$/{ N; /^\n$/D; }' "${profile}" 2>/dev/null || true
    rm -f "${profile}.bak"
    echo "cleaned ${profile}"
  fi
done

echo "Arkad Agent fully uninstalled."
